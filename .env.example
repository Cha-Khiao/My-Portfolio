# Database URLs (PostgreSQL - Supabase / Neon / Vercel Postgres)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase Credentials (For Supabase Auth and Storage Bucket)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Admin Access Control (Whitelist email that has access to Admin Dashboard)
ADMIN_EMAIL="your-email@example.com"

# Session Secret (Random secure string)
AUTH_SECRET="super-secret-portfolio-auth-key"
